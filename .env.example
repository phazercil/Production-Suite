# Copy to .env next to manage.py and fill in. Everything here is optional for a demo.

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
ALLOWED_HOSTS=plant-server,plant-server.local,192.168.100.10
CSRF_TRUSTED_ORIGINS=http://plant-server,http://192.168.100.10
PLANT_TZ=America/New_York

# --- Records database (MariaDB) ----------------------------------------------
# Leave DB_ENGINE unset to use a local SQLite file (demo only).
DB_ENGINE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=production_suite
DB_USER=suite
DB_PASSWORD=

# --- Asset database with changeover instructions (read-only account) -----------
ASSET_DB_HOST=
ASSET_DB_PORT=3306
ASSET_DB_NAME=
ASSET_DB_USER=
ASSET_DB_PASSWORD=

# --- S2K database with open MOs (read-only, optional) ----------------------------
# The suite only reads from it: the connection is opened read-only, only single SELECTs run,
# and nothing is ever created there (not even by the installer). Use a SELECT-only account.
S2K_DB_HOST=
S2K_DB_PORT=3306
S2K_DB_NAME=
S2K_DB_USER=
S2K_DB_PASSWORD=

# --- Machine data database (read-only, optional) ------------------------------
# The database the machines (PLCs, data loggers) write their readings to. Each machine's table and columns
# (pleats per minute, filters cut, recipe, run signal) are picked in Operator Kiosk > Admin > Connections.
MACHINE_DB_HOST=
MACHINE_DB_PORT=3306
MACHINE_DB_NAME=
MACHINE_DB_USER=
MACHINE_DB_PASSWORD=

# --- Paycom employee directory ------------------------------------------------
PAYCOM_SID=
PAYCOM_TOKEN=
# PAYCOM_URL=https://api.paycomonline.net/v4/rest/index.php/api/v1/employeedirectory
# PAYCOM_FIELD_DEPT=
# PAYCOM_FIELD_POSITION=
# PAYCOM_FIELD_BADGE=

# --- Screens and machines -------------------------------------------------------
# If set, each screen opens the suite once as http://server/?key=THIS and remembers it.
STATION_KEY=
# Header X-Feed-Key for machines that push readings to /api/feed/<machine>
FEED_KEY=

# --- Downtime alerts (optional; also set in Operator Kiosk > Admin > Alerts) ---------
# Mail server on the plant network. ALERT_SMTP_INTERNET=1 allows one on the internet (e.g. Office 365).
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_SECURITY=starttls
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_FROM=
ALERT_SMTP_INTERNET=0
# Twilio for text messages (an internet connection, only used when set)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Grafana service-account token (Viewer), so Reports can read your panels -------
GRAFANA_TOKEN=

# --- InfluxDB (optional; also set in Operator Kiosk > Admin > Connections) ----------
# Version 2 = InfluxDB 2.x (Flux, org + token). Version 1 = 1.x or 3.x (InfluxQL, user + password/token, database).
INFLUX_URL=
INFLUX_VERSION=2
INFLUX_ORG=
INFLUX_TOKEN=
INFLUX_USER=
INFLUX_DB=
# Bucket (or database) the suite copies its records into for Grafana. Blank = don't copy.
INFLUX_WRITE_BUCKET=

# Run the minute ticker inside `runserver` (demo). In production run `manage.py runplant` as a service and set 0.
TICKER_IN_PROCESS=0

# --- Plant network lock ---------------------------------------------------------
# Screens may only connect from these ranges, and the server only connects to addresses inside them.
# Private ranges only (10.x, 172.16-31.x, 192.168.x, 100.64-127.x). This server itself is always allowed.
# Used until a shift lead changes it in Operator Kiosk > Admin > Network (stored in the database).
PLANT_NETWORKS="192.168.100.0/24"
