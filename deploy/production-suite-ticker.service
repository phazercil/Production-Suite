# /etc/systemd/system/production-suite-ticker.service — machine readings every minute, S2K/Paycom pulls, webhook
[Unit]
Description=Production Suite plant ticker
After=network.target mariadb.service

[Service]
WorkingDirectory=/opt/production_suite
ExecStart=/opt/production_suite/.venv/bin/python manage.py runplant
Restart=always
User=suite

[Install]
WantedBy=multi-user.target
