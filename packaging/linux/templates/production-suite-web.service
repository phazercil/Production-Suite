# Production Suite web app. Apache (httpd) serves the screens and passes requests to it on 127.0.0.1:8008.
[Unit]
Description=Production Suite web app (behind Apache)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
User=psuite
Group=psuite
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@DIR@/.venv/bin/python @DIR@/serve.py web
Restart=always
RestartSec=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
